<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cardealtg.autopull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DIR__/mac-autopull.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>300</integer>
    <!-- кнопка «Обновить с GitHub» в боте кладёт этот файл — запуск сразу -->
    <key>WatchPaths</key>
    <array>
        <string>__DIR__/data/update_request.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__DIR__/autopull.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/autopull.log</string>
</dict>
</plist>

# Скопируйте в .env и заполните
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_TELEGRAM_ID=123456789

# ИИ читает описания объявлений (необязательно — по умолчанию локальная
# Ollama на этом же Маке, модель выбирается сама из установленных).
# AI_ENABLED=false            — выключить
# AI_MODEL=qwen2.5:14b        — конкретная модель вместо автовыбора
# AI_BASE_URL=https://api.groq.com/openai/v1  — другой OpenAI-совместимый сервер
# AI_API_KEY=...              — ключ такого сервера (для Ollama не нужен)
# AI_MAX_PER_CYCLE=200        — сколько описаний читать за один полный скан
